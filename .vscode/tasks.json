{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TNW: Build and test",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["build", "--no-configuration-cache"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "TNW: Run Minecraft Client",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["runClient", "--no-configuration-cache"],
      "problemMatcher": []
    },
    {
      "label": "TNW: Run Headless Server",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["runServer", "--no-configuration-cache"],
      "problemMatcher": []
    },
    {
      "label": "TNW: Build Modrinth pack",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", ".\\tools\\build-modrinth-pack.ps1"],
      "problemMatcher": []
    },
    {
      "label": "TNW: Validate Modrinth pack",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", ".\\tools\\validate-release.ps1"],
      "problemMatcher": []
    }
  ]
}
